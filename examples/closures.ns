// Closures and higher-order functions (Phase 6, ADR-0027).
function apply(f: (n: number) => number, n: number): number {
    return f(n);
}

let base = 10;
let addBase = (x: number): number => x + base;
console.log(addBase(5)); // 15

console.log(apply((x: number): number => x * 2, 21)); // 42

function double(x: number): number { return x * 2; }
console.log(apply(double, 4)); // 8

function makeAdder(amount: number): (n: number) => number {
    return (n: number): number => n + amount;
}
let add3 = makeAdder(3);
console.log(add3(4)); // 7
console.log(add3(10)); // 13

// Captures are shared cells: the closure and the enclosing frame see the
// same binding, and two closures over it share the same storage.
let counter = 0;
let readCounter = (): number => counter;
let bump = (): number => {
    counter = counter + 1;
    return counter;
};
console.log(bump()); // 1
console.log(bump()); // 2
console.log(counter); // 2
console.log(readCounter()); // 2

// Nested closures capture from the enclosing closure's environment.
type Inner = () => number;
type Outer = () => Inner;
function nested(a: number): Outer {
    let b = a + 1;
    return (): Inner => {
        return (): number => { b = b + 1; return b + a; };
    };
}
let inner = nested(2)();
console.log(inner()); // 6
console.log(inner()); // 7

// A function value captured by another closure keeps working through the cell.
let plusOne = (x: number): number => x + 1;
let callCaptured = (y: number): number => plusOne(y);
console.log(callCaptured(9)); // 10
